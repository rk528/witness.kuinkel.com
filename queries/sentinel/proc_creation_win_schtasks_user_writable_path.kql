imProcessCreate
| where (TargetProcessName endswith "\\schtasks.exe" or TargetProcessFileOriginalName =~ "schtasks.exe") and (TargetProcessCommandLine contains "-create" or TargetProcessCommandLine contains "/create" or TargetProcessCommandLine contains "–create" or TargetProcessCommandLine contains "—create" or TargetProcessCommandLine contains "―create") and (TargetProcessCommandLine contains "\\AppData\\Local\\Temp\\" or TargetProcessCommandLine contains "\\AppData\\Roaming\\" or TargetProcessCommandLine contains "\\Users\\Public\\" or TargetProcessCommandLine contains "\\Windows\\Temp\\" or TargetProcessCommandLine contains "%TEMP%" or TargetProcessCommandLine contains "%TMP%" or TargetProcessCommandLine contains "%APPDATA%" or TargetProcessCommandLine contains "%PUBLIC%")
