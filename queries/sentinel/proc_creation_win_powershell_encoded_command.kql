imProcessCreate
| where (((TargetProcessName endswith "\\powershell.exe" or TargetProcessName endswith "\\pwsh.exe") or (TargetProcessFileOriginalName in~ ("PowerShell.EXE", "pwsh.dll"))) and (TargetProcessCommandLine contains " -e " or TargetProcessCommandLine contains " /e " or TargetProcessCommandLine contains " –e " or TargetProcessCommandLine contains " —e " or TargetProcessCommandLine contains " ―e " or TargetProcessCommandLine contains " -ec " or TargetProcessCommandLine contains " /ec " or TargetProcessCommandLine contains " –ec " or TargetProcessCommandLine contains " —ec " or TargetProcessCommandLine contains " ―ec " or TargetProcessCommandLine contains " -en " or TargetProcessCommandLine contains " /en " or TargetProcessCommandLine contains " –en " or TargetProcessCommandLine contains " —en " or TargetProcessCommandLine contains " ―en " or TargetProcessCommandLine contains " -enc " or TargetProcessCommandLine contains " /enc " or TargetProcessCommandLine contains " –enc " or TargetProcessCommandLine contains " —enc " or TargetProcessCommandLine contains " ―enc " or TargetProcessCommandLine contains " -encodedcommand " or TargetProcessCommandLine contains " /encodedcommand " or TargetProcessCommandLine contains " –encodedcommand " or TargetProcessCommandLine contains " —encodedcommand " or TargetProcessCommandLine contains " ―encodedcommand ")) and (not((ParentProcessName startswith "C:\\Windows\\CCM\\" or ActingProcessName startswith "C:\\Windows\\CCM\\")))
